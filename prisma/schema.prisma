generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                       String                   @db.VarChar(255)
  email                                                      String                   @unique @db.VarChar(255)
  created_at                                                 DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                                                 DateTime?                @default(now()) @db.Timestamptz(6)
  approvals                                                  approvals[]
  approver_group_members                                     approver_group_members[]
  audit_events                                               audit_events[]
  gr_headers                                                 gr_headers[]
  invoice_headers_invoice_headers_assigned_to_user_idTousers invoice_headers[]        @relation("invoice_headers_assigned_to_user_idTousers")
  invoice_headers_invoice_headers_created_byTousers          invoice_headers[]        @relation("invoice_headers_created_byTousers")
  invoice_headers_invoice_headers_updated_byTousers          invoice_headers[]        @relation("invoice_headers_updated_byTousers")
  invoice_status_history                                     invoice_status_history[]
  invoice_validations                                        invoice_validations[]
  po_headers                                                 po_headers[]
  ses_headers                                                ses_headers[]
  validation_runs                                            validation_runs[]
  work_items                                                 work_items[]

  @@map("users")
}

model config_agent_session_events {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id     String
  turn_index     Int      @default(0)
  action         String   @default("build")
  model          String?
  agent_name     String?
  user_message   String
  request_json   Json
  current_config Json?
  raw_response   String?
  parsed_json    Json?
  error          String?
  duration_ms    Int?
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_config_agent_session_events_created_at")
  @@index([session_id, turn_index], map: "idx_config_agent_session_events_session")
}

model agent_runs {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agent_code   String     @db.VarChar(100)
  work_item_id String     @db.Uuid
  input_json   Json
  output_json  Json?
  started_at   DateTime   @db.Timestamptz(6)
  finished_at  DateTime?  @db.Timestamptz(6)
  success      Boolean?
  error        String?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?  @default(now()) @db.Timestamptz(6)
  work_items   work_items @relation(fields: [work_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agent_code], map: "idx_agent_runs_agent_code")
  @@index([started_at], map: "idx_agent_runs_started_at")
  @@index([work_item_id], map: "idx_agent_runs_work_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approval_policies {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @db.VarChar(255)
  priority          Int
  active            Boolean?        @default(true)
  vendor_id         String?         @db.Uuid
  currency          String?         @db.VarChar(3)
  min_amount        Decimal?        @db.Decimal(18, 4)
  max_amount        Decimal?        @db.Decimal(18, 4)
  non_po_only       Boolean?        @default(false)
  match_json        Json?
  approver_group_id String          @db.Uuid
  sequence          Int?            @default(1)
  created_at        DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @default(now()) @db.Timestamptz(6)
  approver_groups   approver_groups @relation(fields: [approver_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendors           vendors?        @relation(fields: [vendor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([active], map: "idx_approval_policies_active")
  @@index([priority], map: "idx_approval_policies_priority")
  @@index([vendor_id], map: "idx_approval_policies_vendor_id")
}

model approvals {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type    doc_type
  doc_id      String          @db.Uuid
  step        Int
  status      workflow_status
  assigned_to String?         @db.Uuid
  note        String?
  acted_at    DateTime?       @db.Timestamptz(6)
  created_at  DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?       @default(now()) @db.Timestamptz(6)
  users       User?           @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([doc_type, doc_id], map: "idx_approvals_doc_type_doc_id")
  @@index([status], map: "idx_approvals_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model approver_group_members {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id        String          @db.Uuid
  user_id         String          @db.Uuid
  level           Int
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  approver_groups approver_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, level], map: "unique_group_level")
  @@unique([group_id, user_id], map: "unique_group_member")
  @@index([group_id], map: "idx_approver_group_members_group_id")
  @@index([group_id, level], map: "idx_approver_group_members_group_level")
  @@index([user_id], map: "idx_approver_group_members_user_id")
}

model approver_groups {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                   @unique @db.VarChar(255)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  approval_policies      approval_policies[]
  approver_group_members approver_group_members[]
}

model attachments {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type    doc_type
  doc_id      String    @db.Uuid
  filename    String    @db.VarChar(255)
  media_type  String    @db.VarChar(100)
  storage_url String
  source      String    @db.VarChar(100)
  sha256      String    @db.VarChar(64)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([doc_type, doc_id], map: "idx_attachments_doc_type_doc_id")
  @@index([sha256], map: "idx_attachments_sha256")
}

model audit_events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type     doc_type
  doc_id       String    @db.Uuid
  event_type   String    @db.VarChar(100)
  by_user_id   String?   @db.Uuid
  at           DateTime? @default(now()) @db.Timestamptz(6)
  payload_json Json?
  users        User?     @relation(fields: [by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([at], map: "idx_audit_events_at")
  @@index([doc_type, doc_id], map: "idx_audit_events_doc_type_doc_id")
  @@index([event_type], map: "idx_audit_events_event_type")
}

model cost_centers {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @db.VarChar(50)
  name       String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([code], map: "idx_cost_centers_code")
}

model external_refs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type    doc_type
  doc_id      String    @db.Uuid
  system_code String    @db.VarChar(50)
  external_id String    @db.VarChar(255)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([doc_type, doc_id], map: "idx_external_refs_doc_type_doc_id")
  @@index([external_id], map: "idx_external_refs_external_id")
  @@index([system_code], map: "idx_external_refs_system_code")
}

model gr_headers {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gr_number           String     @unique @db.VarChar(50)
  po_id               String     @db.Uuid
  receipt_date        DateTime   @db.Date
  received_by_user_id String?    @db.Uuid
  status              gr_status
  reference           String?    @db.VarChar(255)
  carrier             String?    @db.VarChar(255)
  created_at          DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?  @default(now()) @db.Timestamptz(6)
  po_headers          po_headers @relation(fields: [po_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               User?      @relation(fields: [received_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gr_lines            gr_lines[]

  @@index([po_id], map: "idx_gr_headers_po_id")
  @@index([receipt_date], map: "idx_gr_headers_receipt_date")
  @@index([status], map: "idx_gr_headers_status")
  @@index([gr_number], map: "idx_gr_headers_gr_number")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model gr_lines {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gr_id                 String                  @db.Uuid
  po_line_id            String                  @db.Uuid
  qty_received          Decimal                 @db.Decimal(18, 6)
  qty_rejected          Decimal?                @db.Decimal(18, 6)
  uom                   String                  @db.VarChar(20)
  storage_location      String?                 @db.VarChar(100)
  reject_reason_code    String?                 @db.VarChar(50)
  created_at            DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @default(now()) @db.Timestamptz(6)
  gr_headers            gr_headers              @relation(fields: [gr_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  po_lines              po_lines                @relation(fields: [po_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_line_receipts invoice_line_receipts[]
  invoice_lines         invoice_lines[]
  match_results         match_results[]

  @@index([gr_id], map: "idx_gr_lines_gr_id")
  @@index([po_line_id], map: "idx_gr_lines_po_line_id")
}

