  id        String    @id @default(dbgenerated("concat('test_', to_char(now(), 'YYYYMMDDHH24MISS'::text), '_', substr(md5((random())::text), 1, 6))")) @db.VarChar(30)
  name      String    @db.VarChar(255)
  value     String?
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model validation_rules {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String                @unique @db.VarChar(50)
  name                String                @db.VarChar(255)
  description         String?
  rule_type           validation_rule_type
  category            validation_category
  severity            validation_severity
  is_active           Boolean?              @default(true)
  config              Json?                 @default("{}")
  tolerance_percent   Decimal?              @db.Decimal(7, 4)
  tolerance_amount    Decimal?              @db.Decimal(18, 4)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  invoice_validations invoice_validations[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model validation_runs {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id          String          @db.Uuid
  run_type            String          @db.VarChar(50)
  triggered_by        String?         @db.Uuid
  total_rules_checked Int             @default(0)
  errors_found        Int             @default(0)
  warnings_found      Int             @default(0)
  info_found          Int             @default(0)
  confidence_score    Decimal?        @db.Decimal(5, 2)
  fraud_risk_score    Decimal?        @db.Decimal(5, 2)
  started_at          DateTime        @default(now()) @db.Timestamptz(6)
  completed_at        DateTime?       @db.Timestamptz(6)
  duration_ms         Int?
  created_at          DateTime?       @default(now()) @db.Timestamptz(6)
  invoice_headers     invoice_headers @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               User?           @relation(fields: [triggered_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([completed_at(sort: Desc)], map: "idx_validation_runs_completed")
  @@index([invoice_id], map: "idx_validation_runs_invoice_id")
}

